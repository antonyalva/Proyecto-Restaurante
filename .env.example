# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clave de servicio: SOLO en el servidor. Nunca exponerla al navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- App ----
# URL pública usada para generar los QR de las mesas
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secreto para procesar campañas desde un cron externo (header: x-cron-secret)
CRON_SECRET=cambiar-por-un-secreto-largo

# ---- WhatsApp ----
# mock: no envía nada, registra en consola (para desarrollo)
# meta: WhatsApp Cloud API oficial
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
# ID del número por defecto si el local no tiene uno configurado
WHATSAPP_PHONE_NUMBER_ID=
# Token que se configura en Meta para verificar el webhook
WHATSAPP_VERIFY_TOKEN=cambiar-por-otro-secreto
WHATSAPP_API_VERSION=v22.0
# Tamaño de lote por ejecución de procesamiento de campaña
WHATSAPP_LOTE=50
