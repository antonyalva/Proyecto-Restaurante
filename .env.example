# ---- Supabase (Project Settings > API) ----
# También se aceptan los nombres de la integración Supabase <-> Vercel:
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY y SUPABASE_SECRET_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave publicable (sb_publishable_...) o anon (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Clave secreta (sb_secret_...) o service_role (eyJ...): SOLO en el servidor.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ---- App ----
# URL pública usada para generar los QR de las mesas
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secreto para procesar campañas desde un cron externo (header: x-cron-secret)
CRON_SECRET=cambiar-por-un-secreto-largo

# ---- WhatsApp ----
# mock: no envía nada, registra en consola (para desarrollo)
# meta: WhatsApp Cloud API oficial
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
# ID del número por defecto si el local no tiene uno configurado
WHATSAPP_PHONE_NUMBER_ID=
# Token que se configura en Meta para verificar el webhook
WHATSAPP_VERIFY_TOKEN=cambiar-por-otro-secreto
WHATSAPP_API_VERSION=v22.0
# Tamaño de lote por ejecución de procesamiento de campaña
WHATSAPP_LOTE=50
